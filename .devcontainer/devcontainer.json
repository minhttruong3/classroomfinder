{
  "name": "Node.js & Next.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bullseye",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/page.tsx"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  },
  "updateContentCommand": "npm install",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
